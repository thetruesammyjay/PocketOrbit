# Private server-to-server API URL for the Next.js proxy and portfolio SSR. Include /api/v1.
API_INTERNAL_URL=http://localhost:8000/api/v1
AUTH_COOKIE_NAME=pocketorbit_session
# Use the same comma-separated admin emails in both apps/web and apps/api environments.
ADMIN_EMAILS=

# API. Leave DATABASE_URL empty to run the demo API without PostgreSQL.
DATABASE_URL=
APP_ENV=development
SECRET_KEY=replace-this-for-local-development
AUTH_COOKIE_NAME=pocketorbit_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_DAYS=14
MAX_REQUEST_BODY_BYTES=8388608
# Only set ranges for reverse proxies that overwrite/append X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls

# Optional provider endpoints/keys. No wallet signing keys belong here.
SOLANA_RPC_URL=
# EVM_RPC_URL is kept as a fallback for Ethereum only.
EVM_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
# Optional shared Alchemy key (Token API and Portfolio API fallback) and per-chain indexed RPC
# overrides. Each indexed URL must support eth_chainId and alchemy_getTokenBalances.
ALCHEMY_API_KEY=
ETHEREUM_INDEXED_RPC_URL=
BASE_INDEXED_RPC_URL=
ARBITRUM_INDEXED_RPC_URL=
# Comma-separated ERC-20 contract addresses to inspect per EVM network.
ETHEREUM_TOKEN_CONTRACTS=
BASE_TOKEN_CONTRACTS=
ARBITRUM_TOKEN_CONTRACTS=
# auto uses indexed methods and the Alchemy Portfolio API when configured, then contract lists;
# alchemy requires indexed discovery; configured_only uses contract lists only.
EVM_TOKEN_DISCOVERY=auto
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
