# Web application. Include the API prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API. Leave DATABASE_URL empty to run the demo API without PostgreSQL.
DATABASE_URL=
APP_ENV=development
SECRET_KEY=replace-this-for-local-development

# Optional provider endpoints/keys. No wallet signing keys belong here.
SOLANA_RPC_URL=
# EVM_RPC_URL is kept as a fallback for Ethereum only.
EVM_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
# Comma-separated ERC-20 contract addresses to inspect per EVM network.
ETHEREUM_TOKEN_CONTRACTS=
BASE_TOKEN_CONTRACTS=
ARBITRUM_TOKEN_CONTRACTS=
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key
